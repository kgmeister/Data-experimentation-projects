# === Global LLM controls ===
LLM_TIMEOUT_SECONDS=180
LLM_RETRIES=2
LLM_BACKOFF_SECONDS=1.2
LLM_FAILOVER_ON_STATUS=401,403,404,408,429,500-599

# === LLM_0 (Primary) ===
API_URL=https://api-inference.bitdeer.ai/v1/chat/completions
API_KEY=your_key_here
MODEL=aisingapore/Qwen-SEA-LION-v4-32B-IT

# === LLM_1 ===
LLM_1_API_URL=https://api-inference.bitdeer.ai/v1/chat/completions
LLM_1_API_KEY=your_key_here
LLM_1_MODEL=openai/gpt-oss-120b
LLM_1_AUTH_TYPE=bearer

# === LLM_2 ===
LLM_2_API_URL=https://api-inference.bitdeer.ai/v1/chat/completions
LLM_2_API_KEY=your_key_here
LLM_2_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_2_AUTH_TYPE=bearer

# === LLM_3 ===
LLM_3_API_URL=https://api-inference.bitdeer.ai/v1/chat/completions
LLM_3_API_KEY=your_key_here
LLM_3_MODEL=openai/gpt-oss-120b
LLM_3_AUTH_TYPE=bearer

# === LLM_4 ===
LLM_4_API_URL=https://api-inference.bitdeer.ai/v1/chat/completions
LLM_4_API_KEY=your_key_here
LLM_4_MODEL=your_favorite_model_here
LLM_4_AUTH_TYPE=bearer

# === LLM_5 (5th failover) ===
LLM_5_API_URL=https://api-inference.bitdeer.ai/v1/chat/completions
LLM_5_API_KEY=your_key_here
LLM_5_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_5_AUTH_TYPE=bearer

# === Paths ===
DATA_DIR=./Team_Cashew_Synthetic_Data
CLARITY_PORT=5000
